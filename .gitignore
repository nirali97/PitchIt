cd ~/Desktop/pitchit

cat > .gitignore <<'EOF'
# Environment variables and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Databases
*.db
*.sqlite
*.sqlite3

# Node
node_modules/
**/node_modules/
frontend/dist/

# System
.DS_Store
EOF*.tsbuildinfo
*.tsbuildinfo
